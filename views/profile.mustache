<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>VibeOn</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css"></head>

<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand">
        <a href="/" class="logo-link">
          <div class="logo">VO</div>
          <h1>VibeOn</h1>
        </a>
      </div>
      <nav>
        <div class="divider muted">-</div>
        <a class="nav-item" href="/">
          <i class="icon">🏠</i> <span class="label">Головна</span>
        </a>
        <a class="nav-item">
          <i class="icon">📖</i> <span class="label">Стрічка</span>
        </a>
        <a class="nav-item">
          <i class="icon">❤️</i> <span class="label">Улюблене</span>
        </a>
        <a class="nav-item">
          <i class="icon">💬</i> <span class="label">Чати</span>
          <span class="badge">15</span>
        </a>
         <div class="divider muted">База даних</div>
        <a class="nav-item" href="/users">
          <i class="icon">⚙️</i> <span class="label">Користувачі</span>
        </a>
      </nav>
      <div class="footer-options"><a href="support.html">Support</a> · <a href="report.html">Report</a></div>
    </aside>

    <main class="main-wrap">
      <header class="topbar">
        <div class="search">
          <input type="text" placeholder="Пошук користувачів">
        </div>
        <div class="top-actions">
          <button class="pill"><a href="login.html">Увійти / Зареєструватися</a></button>
          <a href="/profile"><img class="user-avatar" src="https://64.media.tumblr.com/3e14b2843171b2703d0bd6f01f1e1c42/a07817157830bb0e-8c/s1280x1920/1b9fd899f7ef512164f0dc61f3260873051a26a2.jpg" alt=""></a>        </div>
      </header>

      <section class="hero">
        <div class="left">
          <h2>Профіль користувача: <strong>PlayerOne</strong></h2>
          <p>Приєднався: 12 листопада 2025</p>
          <p>Локація: м. Полтава, Україна</p>
          <p>Про себе: Захоплююсь відеоіграми і участю в ігрових спільнотах. 🎮</p>
          <p>Кількість постів: 1 | Підписники: 120 | Підписки: 75</p>
          <a href="#" class="cta">Редагувати профіль</a>
        </div>
        <div class="hero-visual">
          <img style="width:120px; height:120px; border-radius:50%" src="https://64.media.tumblr.com/3e14b2843171b2703d0bd6f01f1e1c42/a07817157830bb0e-8c/s1280x1920/1b9fd899f7ef512164f0dc61f3260873051a26a2.jpg" alt=""></div>
      </section>

      <section>
        <h3 class="section-title">Останні пости</h3>
        <div class="cards">
          <article class="card">
            <div class="card-header">
              <div class="avatar"></div>
              <div class="user-info">
                <h4>PlayerOne</h4>
                <span class="time">2h ago</span>
              </div>
            </div>
            <img src="https://static0.srcdn.com/wordpress/wp-content/uploads/2023/03/vlcsnap-2023-03-27-15h32m47s258.jpg" alt="Resident Evil 4 Remake">
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et
                dolore magna aliqua.</p>
            <div class="card-meta">
              <span>❤️ 120</span>
              <span>💬 30</span>
            </div>
          </article>
        </div>
      </section>
      <footer class="site-footer">
        <p>© 2025 VibeOn. Усі права захищені.</p>
        <div class="footer-links">
          <a href="/about">Про нас</a>
          <a href="#">Контакти</a>
          <a href="#">Політика конфіденційності</a>
        </div>
      </footer>
    </main>
  </div>
</body>
</html>
